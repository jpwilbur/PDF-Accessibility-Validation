# --- Python build / env -------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# --- Test / lint caches -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- OS junk -------------------------------------------------------------
.DS_Store
Thumbs.db

# --- IDE / editor (user-specific) ---------------------------------------
.idea/
.vscode/
*.swp
*~

# --- Secrets / credentials (defence in depth) ---------------------------
# The app stores API keys under ~/Library/Application Support/pdf-a11y/
# (platformdirs user-data dir) — never inside the repo. These globs
# cover the common slip-ups if someone copies a credentials file in by
# mistake.
.env
.env.*
*.pem
*.key
credentials.json
*-credentials.json
secrets.yaml
secrets.json
# pdf-a11y's settings file holds the OP API key in plaintext under
# platformdirs; ignore at repo root as a safety net in case anyone
# copies it in.
/settings.json
settings.local.json

# --- Project caches & outputs (anchored to project root only) -----------
/.cache/
/reports/
# Runtime run output (runs.db, runs/<id>/, cache/, settings.json) lives
# under ~/Library/Application Support/pdf-a11y/ — outside the repo by
# design — but this anchor is a safety net for anyone passing
# --output-dir ./runs or similar.
/runs/

# --- Local build/design docs (specs & plans) — not for distribution -----
# Brainstorm specs and implementation plans are kept locally for the
# author's reference; they're build scaffolding, not part of the shipped
# project, so they're never tracked or pushed. (docs/checks.md and
# docs/standards-mapping.md ARE shipped — only the superpowers subtree is
# ignored.)
/docs/superpowers/
